+# %% 阶段 05 新增参数比较和独立验证
+def run_parameters(args):
+    """本阶段新增：9组 OFAT、3组等预算对照和独立种子验证。"""
+    SEEDS = [args.seed + 100*i for i in range(2 if args.quick else 5)]
+    RCM_FORMULATION = "literal_pdf"
